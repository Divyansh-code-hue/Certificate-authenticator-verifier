<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#101a31">
  <title>Certificate Authenticity Verifier</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    :root {
      --navy: #101a31;
      --blue: #3b68f5;
      --blue-hover: #2d55d8;
      --ink: #1c2942;
      --muted: #64748b;
      --line: #e2e8f0;
      --surface: #ffffff;
      --background: #f8fafc;
      --green: #10b981;
      --green-bg: #ecfdf5;
      --green-border: #a7f3d0;
      --red: #ef4444;
      --red-bg: #fef2f2;
      --red-border: #fecaca;
      --amber: #f59e0b;
      --amber-bg: #fffbeb;
      --amber-border: #fde68a;
      --shadow-sm: 0 4px 12px rgba(16, 26, 49, 0.05);
      --shadow-md: 0 12px 30px rgba(16, 26, 49, 0.08);
      --radius: 14px;
    }

    * { box-sizing: border-box; }
    [hidden] { display: none !important; }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      background: var(--background);
      font-family: "DM Sans", -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.5;
    }

    button, input, select { font: inherit; }
    button { cursor: pointer; transition: all 0.15s ease; }
    button:disabled { cursor: not-allowed; opacity: 0.55; }
    h1, h2, h3, h4, p { margin-top: 0; }

    .topbar {
      height: 70px;
      padding: 0 max(24px, calc((100% - 1180px) / 2));
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--navy);
      color: #fff;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      color: #fff;
      text-decoration: none;
      font: 800 20px "Manrope", sans-serif;
      letter-spacing: -0.4px;
    }
    .brand-mark {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: linear-gradient(135deg, #3b68f5, #704be8);
      box-shadow: 0 4px 14px rgba(59, 104, 245, 0.4);
      font-size: 18px;
    }
    .topbar-meta {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.35);
      color: #34d399;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
    }
    .status-dot {
      width: 8px;
      height: 8px;
      background: #10b981;
      border-radius: 50%;
      box-shadow: 0 0 8px #10b981;
    }
    .badge-tag {
      font-size: 12px;
      padding: 4px 10px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 6px;
      color: #cbd5e1;
      font-weight: 600;
    }

    .hero {
      padding: 42px 24px;
      color: #fff;
      text-align: center;
      background: radial-gradient(ellipse at 50% 20%, #203562 0%, var(--navy) 80%);
      border-bottom: 1px solid var(--line);
    }
    .hero h1 {
      margin: 0;
      font: 800 36px "Manrope", sans-serif;
      letter-spacing: -0.8px;
    }

    .main {
      max-width: 1140px;
      margin: 0 auto;
      padding: 28px 20px 80px;
    }
    .tabs {
      display: flex;
      gap: 8px;
      border-bottom: 2px solid var(--line);
      margin-bottom: 28px;
      overflow-x: auto;
    }
    .tab {
      padding: 12px 22px;
      font-family: "Manrope", sans-serif;
      font-weight: 700;
      font-size: 14px;
      color: var(--muted);
      background: transparent;
      border: none;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      cursor: pointer;
      white-space: nowrap;
    }
    .tab:hover { color: var(--blue); }
    .tab.active {
      color: var(--blue);
      border-bottom-color: var(--blue);
    }

    .panel {
      display: none;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .panel.active { display: block; }
    .panel-header {
      padding: 20px 28px;
      border-bottom: 1px solid var(--line);
      background: #fafbfc;
    }
    .panel-header h2 {
      margin: 0;
      font: 800 20px "Manrope", sans-serif;
      color: var(--ink);
    }
    .panel-body { padding: 28px; }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 20px;
      border-radius: 9px;
      border: none;
      background: var(--blue);
      color: #fff;
      font-weight: 600;
      font-size: 14px;
      text-decoration: none;
    }
    .button:hover { background: var(--blue-hover); }
    .button.secondary {
      background: #f1f5f9;
      color: var(--ink);
      border: 1px solid var(--line);
    }
    .button.secondary:hover { background: #e2e8f0; }
    .button.danger {
      background: var(--red);
      color: #fff;
    }
    .button.danger:hover { background: #dc2626; }
    .button.small { padding: 6px 14px; font-size: 12px; }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-bottom: 18px;
    }
    @media (max-width: 680px) {
      .form-grid { grid-template-columns: 1fr; }
    }
    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 18px;
    }
    .field label {
      font-size: 13px;
      font-weight: 700;
      color: var(--ink);
    }
    .field input, .field select {
      padding: 11px 14px;
      border-radius: 9px;
      border: 1px solid var(--line);
      background: #fff;
      color: var(--ink);
      font-size: 14px;
    }
    .field input:focus, .field select:focus {
      border-color: var(--blue);
      outline: none;
      box-shadow: 0 0 0 3px rgba(59, 104, 245, 0.12);
    }

    .quick-search {
      background: #f8fafc;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 18px 20px;
      margin-bottom: 24px;
    }
    .quick-search-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      font-size: 13px;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .search-row {
      display: flex;
      gap: 10px;
    }
    .search-row input {
      flex: 1;
      padding: 11px 16px;
      border-radius: 9px;
      border: 1px solid var(--line);
      font-size: 14px;
    }

    .verify-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }
    @media (max-width: 820px) {
      .verify-grid { grid-template-columns: 1fr; }
    }
    .verify-card {
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 20px;
      background: #fafbfc;
      display: flex;
      flex-direction: column;
    }
    .verify-card-head {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
    }
    .card-num {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: var(--navy);
      color: #fff;
      display: grid;
      place-items: center;
      font: 800 14px "Manrope", sans-serif;
    }
    .verify-card-head h3 {
      font: 700 16px "Manrope", sans-serif;
      margin: 0;
      color: var(--ink);
    }

    .camera-viewport {
      width: 100%;
      height: 230px;
      background: #0f172a;
      border-radius: 10px;
      overflow: hidden;
      display: grid;
      place-items: center;
      position: relative;
      margin-bottom: 14px;
      border: 1px solid #1e293b;
    }
    .camera-viewport video,
    .camera-viewport img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .viewport-placeholder {
      color: #64748b;
      text-align: center;
      font-size: 13px;
    }
    .viewport-placeholder .icon {
      font-size: 38px;
      margin-bottom: 8px;
      display: block;
      opacity: 0.7;
    }
    #reader { width: 100% !important; border: none !important; }
    #reader video { border-radius: 10px; }

    .result-box {
      margin-top: 28px;
      border-radius: var(--radius);
      border: 1px solid var(--line);
      overflow: hidden;
      box-shadow: var(--shadow-md);
      background: #fff;
    }
    .status-banner {
      padding: 24px;
      text-align: center;
    }
    .status-banner.genuine { background: var(--green-bg); border-bottom: 1px solid var(--green-border); color: #065f46; }
    .status-banner.tampered,
    .status-banner.revoked,
    .status-banner.not_found { background: var(--red-bg); border-bottom: 1px solid var(--red-border); color: #991b1b; }
    .status-banner.expired { background: var(--amber-bg); border-bottom: 1px solid var(--amber-border); color: #92400e; }

    .status-icon-circle {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      margin: 0 auto 10px;
      font-size: 24px;
      font-weight: 800;
    }
    .genuine .status-icon-circle { background: #d1fae5; color: var(--green); }
    .tampered .status-icon-circle,
    .revoked .status-icon-circle,
    .not_found .status-icon-circle { background: #fee2e2; color: var(--red); }
    .expired .status-icon-circle { background: #fef3c7; color: var(--amber); }

    .status-title {
      font: 800 22px "Manrope", sans-serif;
      margin: 0;
    }
    .status-desc { font-size: 14px; max-width: 540px; margin: 8px auto 0; line-height: 1.5; }

    .result-content { padding: 24px; }

    .face-compare-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      background: #f8fafc;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 20px;
    }
    .face-box { text-align: center; }
    .face-label {
      font-size: 12px;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
    }
    .face-img-wrap {
      width: 110px;
      height: 110px;
      border-radius: 12px;
      margin: 0 auto;
      overflow: hidden;
      background: #e2e8f0;
      display: grid;
      place-items: center;
      border: 3px solid #fff;
      box-shadow: var(--shadow-sm);
    }
    .face-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
    .face-placeholder { font-size: 32px; color: #94a3b8; }

    .details-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 18px;
      font-size: 14px;
    }
    .details-table th, .details-table td {
      padding: 9px 12px;
      border-bottom: 1px solid var(--line);
      text-align: left;
    }
    .details-table th {
      width: 32%;
      color: var(--muted);
      font-weight: 600;
      background: #fafbfc;
    }
    .details-table td {
      font-weight: 600;
      color: var(--ink);
    }

    .result-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .table-wrap {
      width: 100%;
      overflow-x: auto;
      border: 1px solid var(--line);
      border-radius: 10px;
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
      text-align: left;
    }
    .data-table th {
      background: #f8fafc;
      padding: 12px 14px;
      color: var(--muted);
      font-weight: 700;
      border-bottom: 1px solid var(--line);
    }
    .data-table td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--line);
      vertical-align: middle;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
    }
    .badge.genuine, .badge.valid { background: #d1fae5; color: #065f46; }
    .badge.tampered, .badge.revoked { background: #fee2e2; color: #991b1b; }
    .badge.expired { background: #fef3c7; color: #92400e; }

    .photo-capture-box {
      border: 2px dashed var(--line);
      border-radius: 12px;
      padding: 16px;
      text-align: center;
      background: #fafbfc;
    }
    .photo-capture-viewport {
      width: 170px;
      height: 170px;
      border-radius: 12px;
      background: #e2e8f0;
      margin: 0 auto 12px;
      overflow: hidden;
      display: grid;
      place-items: center;
      border: 2px solid #fff;
      box-shadow: var(--shadow-sm);
    }
    .photo-capture-viewport video,
    .photo-capture-viewport img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--navy);
      color: #fff;
      padding: 12px 20px;
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
      font-size: 14px;
      font-weight: 600;
      z-index: 9999;
    }
  </style>
</head>
<body>

  <header class="topbar">
    <a href="/" class="brand">
      <div class="brand-mark">🛡️</div>
      <span>CertiSure</span>
    </a>
  </header>

  <section class="hero">
    <h1>Certificate Authenticity Verifier</h1>
  </section>

  <main class="main">
    <nav class="tabs" role="tablist">
      <button class="tab active" id="tab-verify" role="tab" data-target="panel-verify">Verification &amp; Checkpoint</button>
      <button class="tab" id="tab-form" role="tab" data-target="panel-form">Certificate Verification Form</button>
      <button class="tab" id="tab-logs" role="tab" data-target="panel-logs">Audit &amp; Verification Logs</button>
    </nav>

    <!-- ===================== PANEL 1: VERIFICATION & CHECKPOINT ===================== -->
    <section class="panel active" id="panel-verify" role="tabpanel">
      <div class="panel-header">
        <h2>Verification &amp; Checkpoint</h2>
      </div>
      <div class="panel-body">

        <div class="quick-search">
          <div class="quick-search-head">
            <span>Instant Certificate Lookup</span>
          </div>
          <div class="search-row">
            <input type="text" id="quick-cert-id" placeholder="Enter University ID or Certificate ID (e.g. 25011234)" autocomplete="off">
            <button class="button" id="btn-quick-verify" type="button">Verify Now</button>
          </div>
        </div>

        <div class="verify-grid">
          <div class="verify-card">
            <div class="verify-card-head">
              <span class="card-num">2</span>
              <h3>QR Code Scan</h3>
            </div>
            <div class="camera-viewport" id="qr-camera-wrap">
              <div id="reader"></div>
              <div class="viewport-placeholder" id="qr-placeholder">
                <span class="icon">▦</span>
                <strong>Camera Ready</strong>
              </div>
            </div>
            <div id="reader-hidden" style="display:none"></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <button class="button small" id="btn-start-qr-scan" type="button">Start QR Camera</button>
              <button class="button small secondary" id="btn-stop-qr-scan" type="button" hidden>Stop Camera</button>
              <button class="button small secondary" id="btn-upload-qr-img" type="button">Scan from Image</button>
              <input type="file" id="input-qr-file" accept="image/*" hidden>
            </div>
          </div>

          <div class="verify-card">
            <div class="verify-card-head">
              <span class="card-num">1</span>
              <h3>Live Attendee Photo</h3>
            </div>
            <div class="camera-viewport">
              <video id="desk-video" autoplay playsinline hidden></video>
              <img id="desk-photo-preview" alt="Live Desk Photo" hidden>
              <div class="viewport-placeholder" id="desk-placeholder">
                <span class="icon">👤</span>
                <strong>Live Desk Camera</strong>
              </div>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <button class="button small" id="btn-start-desk-cam" type="button">Open Desk Camera</button>
              <button class="button small" id="btn-snap-desk-photo" type="button" hidden>Capture Live Photo</button>
              <button class="button small secondary" id="btn-retake-desk-photo" type="button" hidden>Retake</button>
            </div>
          </div>
        </div>

        <div style="display:flex;gap:10px">
          <button class="button" id="btn-complete-checkpoint" type="button" disabled>Verify &amp; Record Check-in</button>
          <button class="button secondary" id="btn-reset-checkpoint" type="button">Next Attendee / Reset</button>
        </div>

        <div id="verification-result-container"></div>
      </div>
    </section>

    <!-- ===================== PANEL 2: GOOGLE FORM INTEGRATION ===================== -->
    <section class="panel" id="panel-form" role="tabpanel">
      <div class="panel-header">
        <h2>Certificate Verification Form</h2>
      </div>
      <div class="panel-body">
        <div id="mainFormScreen" style="max-width:540px;margin:0 auto">
          <form id="googleVerifyForm" novalidate>
            <div class="field">
              <label for="form-name">Full name</label>
              <input type="text" id="form-name" placeholder="e.g. Rahul Sharma" autocomplete="name" required>
            </div>

            <div class="field">
              <label>Photo</label>
              <div class="photo-capture-box">
                <div class="photo-capture-viewport">
                  <video id="form-video" autoplay playsinline hidden></video>
                  <img id="form-photo-preview" alt="Captured Photo" hidden>
                  <div id="form-photo-placeholder" style="font-size:44px;color:#94a3b8">📷</div>
                </div>
                <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap">
                  <button type="button" class="button small" id="btn-start-form-cam">Start Webcam</button>
                  <button type="button" class="button small" id="btn-snap-form-photo" hidden>Snap Photo</button>
                  <button type="button" class="button small secondary" id="btn-retake-form-photo" hidden>Retake</button>
                  <button type="button" class="button small secondary" id="btn-upload-form-file">Upload File</button>
                  <input type="file" id="form-file-input" accept="image/*" hidden>
                </div>
              </div>
            </div>

            <div class="field">
              <label for="form-uid">University ID</label>
              <input type="text" id="form-uid" placeholder="e.g. 25011234" required>
            </div>

            <div class="field">
              <label for="form-phone">Contact number</label>
              <input type="tel" id="form-phone" placeholder="10-digit mobile number" maxlength="10" inputmode="numeric" required>
            </div>

            <div class="field">
              <label for="form-dob">Date of birth</label>
              <input type="date" id="form-dob" required>
            </div>

            <button type="submit" class="button" id="btn-form-submit" style="width:100%;padding:14px;margin-top:10px">Submit to MongoDB</button>
          </form>
        </div>

        <div id="mainFormThanks" style="display:none;text-align:center;padding:32px 0">
          <div style="width:72px;height:72px;margin:0 auto 16px;border-radius:50%;background:#10b981;color:#fff;font-size:38px;line-height:72px">✓</div>
          <h2 style="font:800 24px 'Manrope',sans-serif;margin-bottom:8px">Thanks for your submission!</h2>
          <div style="display:flex;gap:10px;justify-content:center;margin-top:20px">
            <button type="button" class="button" id="btn-view-in-logs">View in Audit &amp; Verification Logs</button>
            <button type="button" class="button secondary" id="btn-form-another">Submit another response</button>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== PANEL 3: AUDIT & VERIFICATION LOGS ===================== -->
    <section class="panel" id="panel-logs" role="tabpanel">
      <div class="panel-header" style="display:flex;justify-content:space-between;align-items:center">
        <h2>Audit &amp; Verification Logs</h2>
        <button class="button small secondary" id="btn-refresh-logs" type="button">Refresh Logs</button>
      </div>
      <div class="panel-body">
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Photo</th>
                <th>Full Name</th>
                <th>University ID</th>
                <th>Contact</th>
                <th>Date of Birth</th>
                <th>Submitted At</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="mongo-logs-tbody">
              <tr><td colspan="8" style="text-align:center;color:var(--muted)">Loading records from MongoDB...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

  </main>

  <div class="toast" id="toast" hidden></div>

  <script>
    "use strict";

    const $ = id => document.getElementById(id);
    let html5QrCode = null;
    let formStream = null;
    let deskStream = null;
    let formPhotoData = "";
    let deskPhotoData = "";
    let scannedId = "";

    function toast(msg) {
      const t = $("toast");
      t.textContent = msg;
      t.hidden = false;
      clearTimeout(t._timer);
      t._timer = setTimeout(() => { t.hidden = true; }, 3000);
    }

    async function apiRequest(endpoint, { method = "GET", body } = {}) {
      try {
        const options = {
          method,
          headers: { "Content-Type": "application/json" }
        };
        if (body) options.body = JSON.stringify(body);
        const res = await fetch(endpoint, options);
        const data = await res.json().catch(() => ({}));
        return { ok: res.ok, status: res.status, data };
      } catch (err) {
        return { ok: false, status: 0, data: { error: "Network connection error" } };
      }
    }

    // Tabs
    document.querySelectorAll(".tab").forEach(tab => {
      tab.addEventListener("click", () => {
        document.querySelectorAll(".tab").forEach(t => t.classList.remove("active"));
        document.querySelectorAll(".panel").forEach(p => p.classList.remove("active"));
        tab.classList.add("active");
        const panelId = tab.getAttribute("data-target");
        if ($(panelId)) $(panelId).classList.add("active");
        if (panelId === "panel-logs") loadMongoLogs();
      });
    });

    // Camera helpers
    async function startCam(videoElem, placeholderElem, previewElem) {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { width: 480, height: 480, facingMode: "user" }
        });
        videoElem.srcObject = stream;
        videoElem.hidden = false;
        placeholderElem.hidden = true;
        previewElem.hidden = true;
        return stream;
      } catch (err) {
        toast("Unable to open camera: " + err.message);
        return null;
      }
    }

    function snapPhoto(videoElem, previewElem, placeholderElem, onDone) {
      const canvas = document.createElement("canvas");
      canvas.width = 320;
      canvas.height = 320;
      const ctx = canvas.getContext("2d");
      ctx.drawImage(videoElem, 0, 0, 320, 320);
      const b64 = canvas.toDataURL("image/jpeg", 0.82);
      previewElem.src = b64;
      previewElem.hidden = false;
      videoElem.hidden = true;
      placeholderElem.hidden = true;
      if (onDone) onDone(b64);
      return b64;
    }

    // Google Form live photo
    $("btn-start-form-cam").addEventListener("click", async () => {
      formStream = await startCam($("form-video"), $("form-photo-placeholder"), $("form-photo-preview"));
      if (formStream) {
        $("btn-start-form-cam").hidden = true;
        $("btn-snap-form-photo").hidden = false;
        $("btn-retake-form-photo").hidden = true;
      }
    });

    $("btn-snap-form-photo").addEventListener("click", () => {
      formPhotoData = snapPhoto($("form-video"), $("form-photo-preview"), $("form-photo-placeholder"), b64 => { formPhotoData = b64; });
      if (formStream) formStream.getTracks().forEach(t => t.stop());
      formStream = null;
      $("btn-snap-form-photo").hidden = true;
      $("btn-retake-form-photo").hidden = false;
    });

    $("btn-retake-form-photo").addEventListener("click", async () => {
      formPhotoData = "";
      $("form-photo-preview").hidden = true;
      formStream = await startCam($("form-video"), $("form-photo-placeholder"), $("form-photo-preview"));
      if (formStream) {
        $("btn-snap-form-photo").hidden = false;
        $("btn-retake-form-photo").hidden = true;
      }
    });

    $("btn-upload-form-file").addEventListener("click", () => $("form-file-input").click());
    $("form-file-input").addEventListener("change", (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement("canvas");
          const MAX = 320;
          const scale = Math.min(1, MAX / Math.max(img.width, img.height));
          canvas.width = Math.round(img.width * scale);
          canvas.height = Math.round(img.height * scale);
          canvas.getContext("2d").drawImage(img, 0, 0, canvas.width, canvas.height);
          formPhotoData = canvas.toDataURL("image/jpeg", 0.82);
          $("form-photo-preview").src = formPhotoData;
          $("form-photo-preview").hidden = false;
          $("form-photo-placeholder").hidden = true;
          $("form-video").hidden = true;
          $("btn-start-form-cam").hidden = true;
          $("btn-snap-form-photo").hidden = true;
          $("btn-retake-form-photo").hidden = false;
        };
        img.src = ev.target.result;
      };
      reader.readAsDataURL(file);
    });

    // Desk photo for checkpoint
    $("btn-start-desk-cam").addEventListener("click", async () => {
      deskStream = await startCam($("desk-video"), $("desk-placeholder"), $("desk-photo-preview"));
      if (deskStream) {
        $("btn-start-desk-cam").hidden = true;
        $("btn-snap-desk-photo").hidden = false;
        $("btn-retake-desk-photo").hidden = true;
      }
    });

    $("btn-snap-desk-photo").addEventListener("click", () => {
      deskPhotoData = snapPhoto($("desk-video"), $("desk-photo-preview"), $("desk-placeholder"), b64 => { deskPhotoData = b64; });
      if (deskStream) deskStream.getTracks().forEach(t => t.stop());
      deskStream = null;
      $("btn-snap-desk-photo").hidden = true;
      $("btn-retake-desk-photo").hidden = false;
      toast("Live desk photo captured.");
    });

    $("btn-retake-desk-photo").addEventListener("click", async () => {
      deskPhotoData = "";
      $("desk-photo-preview").hidden = true;
      deskStream = await startCam($("desk-video"), $("desk-placeholder"), $("desk-photo-preview"));
      if (deskStream) {
        $("btn-snap-desk-photo").hidden = false;
        $("btn-retake-desk-photo").hidden = true;
      }
    });

    // Form submission to MongoDB
    $("googleVerifyForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const name = $("form-name").value.trim();
      const uid = $("form-uid").value.trim();
      const phone = $("form-phone").value.trim();
      const dob = $("form-dob").value;

      if (!name || !uid) {
        toast("Full name and University ID are required.");
        return;
      }

      $("btn-form-submit").disabled = true;
      $("btn-form-submit").textContent = "Saving to MongoDB...";

      const res = await apiRequest("/api/submit-form", {
        method: "POST",
        body: {
          name,
          photo: formPhotoData,
          universityId: uid,
          contactNumber: phone,
          dateOfBirth: dob
        }
      });

      $("btn-form-submit").disabled = false;
      $("btn-form-submit").textContent = "Submit to MongoDB";

      if (res.ok) {
        toast("Saved to MongoDB database!");
        $("mainFormScreen").style.display = "none";
        $("mainFormThanks").style.display = "block";
      } else {
        toast("Error saving data: " + (res.data.error || "Unknown error"));
      }
    });

    $("btn-form-another").addEventListener("click", () => {
      $("googleVerifyForm").reset();
      formPhotoData = "";
      $("form-photo-preview").hidden = true;
      $("form-photo-placeholder").hidden = false;
      $("btn-start-form-cam").hidden = false;
      $("btn-retake-form-photo").hidden = true;
      $("mainFormThanks").style.display = "none";
      $("mainFormScreen").style.display = "block";
    });

    $("btn-view-in-logs").addEventListener("click", () => {
      $("tab-logs").click();
    });

    // Load MongoDB logs into Audit & Verification Logs table
    async function loadMongoLogs() {
      const res = await apiRequest("/api/logs");
      const tbody = $("mongo-logs-tbody");
      if (!res.ok || !res.data) {
        tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;color:var(--muted)">Failed to load records from MongoDB.</td></tr>`;
        return;
      }

      const rows = res.data;
      if (rows.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;color:var(--muted)">No records in MongoDB yet. Fill the Certificate Verification Form to add data.</td></tr>`;
        return;
      }

      tbody.innerHTML = rows.map(r => `
        <tr>
          <td>
            ${r.photo ? `<img src="${r.photo}" alt="Photo" style="width:42px;height:42px;object-fit:cover;border-radius:8px;border:1px solid var(--line);cursor:pointer" onclick="window.open('${r.photo}')">` : `<span style="font-size:22px;color:#94a3b8">👤</span>`}
          </td>
          <td><strong>${escapeHtml(r.name)}</strong></td>
          <td><code style="font-family:'JetBrains Mono';font-weight:700">${escapeHtml(r.universityId)}</code></td>
          <td>${escapeHtml(r.contactNumber || "—")}</td>
          <td>${escapeHtml(r.dateOfBirth || "—")}</td>
          <td style="color:var(--muted);font-size:12px">${r.createdAt ? new Date(r.createdAt).toLocaleString() : "—"}</td>
          <td><span class="badge ${r.status === 'revoked' ? 'revoked' : 'valid'}">${escapeHtml(r.status || 'valid')}</span></td>
          <td style="display:flex;gap:8px;justify-content:flex-start;flex-wrap:wrap">
            <button class="button small secondary" style="padding:4px 10px;font-size:12px" onclick="verifyRecordDirect('${escapeHtml(r.universityId)}')">Verify Now</button>
            <button class="button small" style="padding:4px 10px;font-size:12px;background:#dc2626;border-color:#dc2626;color:#fff" onclick="deleteLogRecord('${escapeHtml(r.universityId)}')">Delete</button>
          </td>
        </tr>
      `).join("");
    }

    window.verifyRecordDirect = function(uid) {
      $("tab-verify").click();
      $("quick-cert-id").value = uid;
      scannedId = uid;
      executeVerification(uid);
    };

    window.deleteLogRecord = async function(uid) {
      if (!uid) return;
      const confirmed = window.confirm(`Delete the log for ${uid}? This cannot be undone.`);
      if (!confirmed) return;

      const res = await apiRequest(`/api/logs/${encodeURIComponent(uid)}`, { method: "DELETE" });
      if (!res.ok) {
        toast(res.data.error || "Unable to delete log entry.");
        return;
      }

      toast(res.data.message || "Log deleted.");
      loadMongoLogs();
    };

    $("btn-refresh-logs").addEventListener("click", loadMongoLogs);

    // QR Scanner
    async function startQrScanner() {
      if (html5QrCode) {
        try { await html5QrCode.stop(); } catch (_) {}
      }
      $("qr-placeholder").hidden = true;
      $("btn-start-qr-scan").hidden = true;
      $("btn-stop-qr-scan").hidden = false;

      html5QrCode = new Html5Qrcode("reader");
      try {
        await html5QrCode.start(
          { facingMode: "environment" },
          { fps: 12, qrbox: { width: 220, height: 220 } },
          onQrCodeDecoded,
          () => {}
        );
      } catch (err) {
        $("qr-placeholder").hidden = false;
        $("btn-start-qr-scan").hidden = false;
        $("btn-stop-qr-scan").hidden = true;
      }
    }

    async function stopQrScanner() {
      if (html5QrCode) {
        try {
          await html5QrCode.stop();
          html5QrCode.clear();
        } catch (_) {}
        html5QrCode = null;
      }
      $("qr-placeholder").hidden = false;
      $("btn-start-qr-scan").hidden = false;
      $("btn-stop-qr-scan").hidden = true;
    }

    $("btn-start-qr-scan").addEventListener("click", startQrScanner);
    $("btn-stop-qr-scan").addEventListener("click", stopQrScanner);

    $("btn-upload-qr-img").addEventListener("click", () => $("input-qr-file").click());
    $("input-qr-file").addEventListener("change", async (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      try {
        const tempScanner = new Html5Qrcode("reader-hidden");
        const decodedText = await tempScanner.scanFile(file, true);
        tempScanner.clear();
        onQrCodeDecoded(decodedText);
      } catch (err) {
        toast("No readable QR code found.");
      }
    });

    function extractCertId(raw) {
      if (!raw) return "";
      let text = String(raw).trim();
      if (text.includes("/verify/")) {
        text = text.split("/verify/")[1].split("?")[0].split("/")[0].trim();
      }
      return text;
    }

    async function onQrCodeDecoded(decodedText) {
      const certId = extractCertId(decodedText);
      if (!certId) {
        toast("QR format unrecognized.");
        return;
      }
      stopQrScanner();
      scannedId = certId;
      $("quick-cert-id").value = certId;
      $("btn-complete-checkpoint").disabled = false;
      toast("QR Scanned: " + certId);
      await executeVerification(certId);
    }

    // Direct Verification
    async function executeVerification(certId) {
      if (!certId) {
        toast("Please enter an ID.");
        return;
      }
      const container = $("verification-result-container");
      container.innerHTML = `<div style="text-align:center;padding:24px;color:var(--muted)">Verifying SHA-256 fingerprint against MongoDB database...</div>`;

      const res = await apiRequest(`/api/verify/${encodeURIComponent(certId)}`);
      renderVerificationResult(res.data, certId);
    }

    $("btn-quick-verify").addEventListener("click", () => {
      const id = $("quick-cert-id").value.trim();
      scannedId = id;
      $("btn-complete-checkpoint").disabled = !id;
      executeVerification(id);
    });

    $("quick-cert-id").addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        $("btn-quick-verify").click();
      }
    });

    $("btn-complete-checkpoint").addEventListener("click", async () => {
      const certId = scannedId || $("quick-cert-id").value.trim();
      if (!certId) return;
      const res = await apiRequest("/api/checkpoint", {
        method: "POST",
        body: {
          student_id: certId,
          captured_photo: deskPhotoData
        }
      });
      renderVerificationResult(res.data, certId);
      toast("Verification check-in recorded.");
    });

    $("btn-reset-checkpoint").addEventListener("click", () => {
      scannedId = "";
      deskPhotoData = "";
      $("quick-cert-id").value = "";
      $("desk-photo-preview").hidden = true;
      $("desk-placeholder").hidden = false;
      $("btn-start-desk-cam").hidden = false;
      $("btn-snap-desk-photo").hidden = true;
      $("btn-retake-desk-photo").hidden = true;
      $("btn-complete-checkpoint").disabled = true;
      $("verification-result-container").innerHTML = "";
      stopQrScanner();
      if (deskStream) deskStream.getTracks().forEach(t => t.stop());
      deskStream = null;
      toast("Station reset for next attendee.");
    });

    function renderVerificationResult(data, fallbackId) {
      const container = $("verification-result-container");
      const result = data.result || data.status || "not_found";
      const cert = data.certificate || null;

      let bannerClass = "not_found";
      let statusIcon = "✕";
      let statusTitle = "CERTIFICATE NOT FOUND";
      let statusDesc = data.message || "ID is not registered in MongoDB.";

      if (result === "genuine" || result === "verified") {
        bannerClass = "genuine";
        statusIcon = "✓";
        statusTitle = "GENUINE CERTIFICATE";
        statusDesc = "Cryptographic SHA-256 fingerprint matches the database record.";
      } else if (result === "tampered") {
        bannerClass = "tampered";
        statusIcon = "⚠";
        statusTitle = "TAMPER DETECTED / FORGERY";
        statusDesc = "Record hash does not match computed SHA-256 integrity fingerprint.";
      } else if (result === "revoked") {
        bannerClass = "revoked";
        statusIcon = "🚫";
        statusTitle = "REVOKED CERTIFICATE";
        statusDesc = "This credential was officially revoked.";
      } else if (result === "expired") {
        bannerClass = "expired";
        statusIcon = "⏳";
        statusTitle = "EXPIRED CERTIFICATE";
        statusDesc = "Validity period has expired.";
      }

      const registeredPhoto = (cert && cert.photo_data) || "";
      const deskPhoto = deskPhotoData || data.captured_photo || "";

      let faceCompareHtml = "";
      if (cert) {
        faceCompareHtml = `
          <div class="face-compare-grid">
            <div class="face-box">
              <div class="face-label">Registered Photo (MongoDB)</div>
              <div class="face-img-wrap">
                ${registeredPhoto ? `<img src="${registeredPhoto}" alt="Registered Face">` : `<span class="face-placeholder">👤</span>`}
              </div>
            </div>
            <div class="face-box">
              <div class="face-label">Live Desk Snapshot</div>
              <div class="face-img-wrap">
                ${deskPhoto ? `<img src="${deskPhoto}" alt="Live Desk Face">` : `<span class="face-placeholder">📷</span>`}
              </div>
            </div>
          </div>
        `;
      }

      let detailsHtml = "";
      if (cert) {
        detailsHtml = `
          <table class="details-table">
            <tbody>
              <tr><th>University ID</th><td>${cert.certificate_id || fallbackId}</td></tr>
              <tr><th>Recipient Name</th><td>${cert.recipient_name || "—"}</td></tr>
              <tr><th>Issued At</th><td>${cert.issued_at ? new Date(cert.issued_at).toLocaleString() : "—"}</td></tr>
              <tr><th>Expires At</th><td>${cert.expires_at ? new Date(cert.expires_at).toLocaleString() : "Permanent"}</td></tr>
              <tr><th>Status</th><td><span class="badge ${bannerClass}">${cert.status || result}</span></td></tr>
            </tbody>
          </table>

        `;
      }

      let actionsHtml = `
        <div class="result-actions">
          ${cert ? `
            <button class="button danger small" id="btn-action-revoke" type="button">Revoke Certificate</button>
            <button class="button secondary small" id="btn-action-restore" type="button">Restore Valid</button>
            <a class="button secondary small" target="_blank" href="/verify/${cert.certificate_id}">Public Link</a>
          ` : ""}
        </div>
      `;

      container.innerHTML = `
        <div class="result-box">
          <div class="status-banner ${bannerClass}">
            <div class="status-icon-circle">${statusIcon}</div>
            <div class="status-title">${statusTitle}</div>
            <div class="status-desc">${statusDesc}</div>
          </div>
          <div class="result-content">
            ${faceCompareHtml}
            ${detailsHtml}
            ${actionsHtml}
          </div>
        </div>
      `;

      if (cert) {
        const revokeBtn = $("btn-action-revoke");
        if (revokeBtn) {
          revokeBtn.addEventListener("click", async () => {
            await apiRequest(`/api/revoke/${cert.certificate_id}`, { method: "POST" });
            toast("Certificate revoked.");
            executeVerification(cert.certificate_id);
          });
        }
        const restoreBtn = $("btn-action-restore");
        if (restoreBtn) {
          restoreBtn.addEventListener("click", async () => {
            await apiRequest(`/api/restore/${cert.certificate_id}`, { method: "POST" });
            toast("Restored to genuine valid state.");
            executeVerification(cert.certificate_id);
          });
        }
      }
    }

    function escapeHtml(str) {
      if (!str) return "";
      return String(str).replace(/[&<>"']/g, m => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
      })[m]);
    }

    (async function init() {
      loadMongoLogs();
    })();
  </script>
</body>
</html>
