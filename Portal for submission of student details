<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Certificate Verification Form</title>
<style>
  :root {
    --bg: #f4f6fb; --card: #ffffff; --text: #1d2433; --muted: #6b7385;
    --primary: #4f46e5; --primary-dark: #4338ca; --border: #d9deea; --error: #dc2626; --ok: #16a34a;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
    background: var(--bg); color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; padding: 20px;
  }
  .card {
    background: var(--card); width: 100%; max-width: 460px; padding: 32px;
    border-radius: 16px; box-shadow: 0 10px 30px rgba(20, 30, 70, .10);
  }
  h1 { margin: 0 0 4px; font-size: 1.5rem; }
  .sub { margin: 0 0 24px; color: var(--muted); font-size: .92rem; }
  label { display: block; font-weight: 600; font-size: .88rem; margin: 16px 0 6px; }
  input[type="text"], input[type="tel"], input[type="date"], input[type="file"] {
    width: 100%; padding: 11px 12px; border: 1px solid var(--border); border-radius: 10px;
    font-size: .95rem; background: #fff; color: var(--text);
  }
  input:focus { outline: 2px solid var(--primary); outline-offset: 1px; }
  .err { color: var(--error); font-size: .8rem; min-height: 1em; margin-top: 4px; }
  .preview-wrap { display: none; margin-top: 10px; }
  .preview-wrap img {
    width: 96px; height: 96px; object-fit: cover; border-radius: 12px; border: 1px solid var(--border);
  }
  button {
    width: 100%; margin-top: 24px; padding: 13px; border: 0; border-radius: 10px;
    background: var(--primary); color: #fff; font-size: 1rem; font-weight: 600; cursor: pointer;
  }
  button:hover { background: var(--primary-dark); }
  button:disabled { opacity: .6; cursor: not-allowed; }
  .banner { margin-top: 14px; font-size: .85rem; color: var(--error); text-align: center; }
  #thanks { display: none; text-align: center; padding: 24px 0; }
  #thanks .tick {
    width: 72px; height: 72px; margin: 0 auto 16px; border-radius: 50%;
    background: var(--ok); color: #fff; font-size: 38px; line-height: 72px;
  }
  #thanks h2 { margin: 0 0 8px; }
  #thanks p { color: var(--muted); margin: 4px 0; }
  .ghost { background: transparent; color: var(--primary); border: 1px solid var(--primary); }
  .ghost:hover { background: #eef0ff; }
</style>
</head>
<body>

<div class="card">

  <!-- FORM SCREEN -->
  <div id="formScreen">
    <h1>Certificate Verification</h1>
    <p class="sub">Fill in your details to request verification of your certificate.</p>

    <form id="verifyForm" novalidate>
      <label for="name">Full name</label>
      <input type="text" id="name" placeholder="e.g. Rahul Sharma" autocomplete="name" />
      <div class="err" id="nameErr"></div>

      <label for="photo">Photo</label>
      <input type="file" id="photo" accept="image/*" />
      <div class="preview-wrap" id="previewWrap"><img id="preview" alt="Photo preview" /></div>
      <div class="err" id="photoErr"></div>

      <label for="uid">University ID</label>
      <input type="text" id="uid" placeholder="e.g. 25011234" />
      <div class="err" id="uidErr"></div>

      <label for="phone">Contact number</label>
      <input type="tel" id="phone" placeholder="10-digit mobile number" maxlength="10" inputmode="numeric" />
      <div class="err" id="phoneErr"></div>

      <label for="dob">Date of birth</label>
      <input type="date" id="dob" />
      <div class="err" id="dobErr"></div>

      <button type="submit" id="submitBtn">Submit</button>
      <div class="banner" id="banner"></div>
    </form>
  </div>

  <!-- THANK YOU SCREEN -->
  <div id="thanks">
    <div class="tick">✓</div>
    <h2>Thanks for your submission!</h2>
    <p>Your details have been received.</p>
    <p>We will verify your certificate soon.</p>
    <button class="ghost" id="againBtn">Submit another response</button>
  </div>

</div>

<script type="module">
  // ============================================================
  // 1. PASTE YOUR FIREBASE CONFIG HERE
  //    Firebase Console > Project settings > Your apps > Web app
  // ============================================================
  const firebaseConfig = {
    apiKey: "YOUR_API_KEY",
    authDomain: "YOUR_PROJECT.firebaseapp.com",
    projectId: "YOUR_PROJECT_ID",
    storageBucket: "YOUR_PROJECT.appspot.com",
    messagingSenderId: "YOUR_SENDER_ID",
    appId: "YOUR_APP_ID"
  };

  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
  import { getFirestore, collection, addDoc, serverTimestamp }
    from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

  const configured = !firebaseConfig.apiKey.startsWith("YOUR_");
  let db = null;
  if (configured) {
    db = getFirestore(initializeApp(firebaseConfig));
  }

  // ---------- element helpers ----------
  const $ = (id) => document.getElementById(id);
  const form = $("verifyForm");
  let photoDataUrl = ""; // compressed base64 photo

  // ---------- photo: preview + compress (keeps Firestore doc well under 1 MB) ----------
  $("photo").addEventListener("change", (e) => {
    const file = e.target.files[0];
    $("photoErr").textContent = "";
    photoDataUrl = "";
    $("previewWrap").style.display = "none";
    if (!file) return;

    if (!file.type.startsWith("image/")) {
      $("photoErr").textContent = "Please choose an image file.";
      return;
    }
    if (file.size > 5 * 1024 * 1024) {
      $("photoErr").textContent = "Image must be under 5 MB.";
      return;
    }

    const reader = new FileReader();
    reader.onload = () => {
      const img = new Image();
      img.onload = () => {
        const MAX = 300; // max width/height in px
        const scale = Math.min(1, MAX / Math.max(img.width, img.height));
        const canvas = document.createElement("canvas");
        canvas.width = Math.round(img.width * scale);
        canvas.height = Math.round(img.height * scale);
        canvas.getContext("2d").drawImage(img, 0, 0, canvas.width, canvas.height);
        photoDataUrl = canvas.toDataURL("image/jpeg", 0.8);
        $("preview").src = photoDataUrl;
        $("previewWrap").style.display = "block";
      };
      img.src = reader.result;
    };
    reader.readAsDataURL(file);
  });

  // ---------- validation ----------
  function validate() {
    let ok = true;
    const set = (id, msg) => { $(id).textContent = msg; if (msg) ok = false; };

    const name = $("name").value.trim();
    const uid = $("uid").value.trim();
    const phone = $("phone").value.trim();
    const dob = $("dob").value;

    set("nameErr", name.length < 2 ? "Please enter your full name." : "");
    set("photoErr", photoDataUrl ? "" : "Please upload your photo.");
    set("uidErr", uid.length < 4 ? "Please enter a valid university ID." : "");
    set("phoneErr", /^[6-9]\d{9}$/.test(phone) ? "" : "Enter a valid 10-digit mobile number.");

    let dobMsg = "";
    if (!dob) dobMsg = "Please select your date of birth.";
    else if (new Date(dob) >= new Date()) dobMsg = "Date of birth must be in the past.";
    set("dobErr", dobMsg);

    return ok;
  }

  // ---------- save data ----------
  async function saveData(data) {
    if (configured) {
      // Firestore
      await addDoc(collection(db, "verification_requests"), {
        ...data,
        createdAt: serverTimestamp()
      });
    } else {
      // Demo fallback so the form still works before Firebase is set up
      const all = JSON.parse(localStorage.getItem("verification_requests") || "[]");
      all.push({ ...data, createdAt: new Date().toISOString() });
      localStorage.setItem("verification_requests", JSON.stringify(all));
      console.warn("Firebase not configured: saved to localStorage instead.");
    }
  }

  // ---------- submit ----------
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    $("banner").textContent = "";
    if (!validate()) return;

    const btn = $("submitBtn");
    btn.disabled = true;
    btn.textContent = "Submitting…";

    try {
      await saveData({
        name: $("name").value.trim(),
        photo: photoDataUrl,
        universityId: $("uid").value.trim(),
        contactNumber: $("phone").value.trim(),
        dateOfBirth: $("dob").value
      });
      $("formScreen").style.display = "none";
      $("thanks").style.display = "block";
    } catch (err) {
      console.error(err);
      $("banner").textContent = "Something went wrong while saving. Please try again.";
    } finally {
      btn.disabled = false;
      btn.textContent = "Submit";
    }
  });

  // ---------- submit another ----------
  $("againBtn").addEventListener("click", () => {
    form.reset();
    photoDataUrl = "";
    $("previewWrap").style.display = "none";
    $("thanks").style.display = "none";
    $("formScreen").style.display = "block";
  });
</script>
</body>
</html>
